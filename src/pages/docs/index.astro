---
import { MinisiteNav, DocsSidebar } from '@oimlsmart/site-shell'
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Story', href: '/story' },
  { label: 'Docs', href: '/docs' },
  { label: 'Demo', href: '/demo' },
]
const allDocs = await getCollection('docs')
const chapters = allDocs.filter(d => d.id.startsWith('nmi/') && true)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
const overview = allDocs.find(d => d.id === 'oiml-rec/overview')
---

<Base title="SMI documentation" description="The SMART Measuring Instruments documentation.">
  <MinisiteNav sections={NAV} base="/smi" />
  <div class="max-w-7xl mx-auto px-6 py-10 grid gap-10 lg:grid-cols-[16rem_1fr]">
    <aside><DocsSidebar order={['nmi']} labels={{ 'nmi': 'SMI Documentation' }} hrefBase="/smi/docs/" /></aside>
    <main class="docs-body">
      <p class="font-mono text-xs tracking-widest uppercase text-ink-muted mb-3">SMART Recommendations · Docs</p>
      <h1 class="font-serif text-3xl font-semibold text-ink mb-6">The SMI documentation</h1>
      {overview && <p class="text-ink-soft mb-6">{overview.data.description ?? 'The authoring corpus: method, subjects, requirements, tests, forms, packaging, walkthroughs.'} Start with the overview, then the chapters in order.</p>}
      <ul class="mt-4 space-y-3">
        {overview && <li><a class="text-accent font-medium" href="/recs/docs/oiml-rec/overview">Overview — the corpus map</a></li>}
        {chapters.map(d => (
          <li><a class="text-accent font-medium" href={`/recs/docs/${d.id}`}>{d.data.shortTitle ?? d.data.title ?? d.id.split('/').pop()}</a>{d.data.description ? <span class="text-ink-soft"> — {d.data.description}</span> : null}</li>
        ))}
      </ul>
    </main>
  </div>
</Base>
